<Window x:Class="WpfAppSistemaDeLoja.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LojaVirtual | Gestão" Height="900" Width="1440"
        MinHeight="760" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FA"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Navy" Color="#17243A"/>
        <SolidColorBrush x:Key="NavyLight" Color="#243650"/>
        <SolidColorBrush x:Key="Accent" Color="#4776E6"/>
        <SolidColorBrush x:Key="TextMain" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8993A4"/>
        <SolidColorBrush x:Key="Line" Color="#E9EDF3"/>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#B9C4D4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,13"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#263B59"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#314D73"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="BorderBrush" Value="#E9EDF3"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8993A4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4776E6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FormInput" TargetType="TextBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="7"/><Setter Property="MinHeight" Value="32"/></Style>
        <Style x:Key="FormCombo" TargetType="ComboBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="6"/><Setter Property="MinHeight" Value="32"/></Style>
        <Style x:Key="FormDataGrid" TargetType="DataGrid"><Setter Property="Margin" Value="4,12,4,4"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="True"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="CanUserAddRows" Value="False"/></Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource Navy}">
            <DockPanel Margin="20,24,20,20">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="5,0,0,34">
                        <Border Width="38" Height="38" CornerRadius="11" Background="#4776E6">
                            <TextBlock Text="L" Foreground="White" FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="LojaVirtual" Foreground="White" FontSize="17" FontWeight="Bold"/>
                            <TextBlock Text="PAINEL DE GESTÃO" Foreground="#91A1B8" FontSize="9" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="MENU PRINCIPAL" Foreground="#71829B" FontSize="10"
                               FontWeight="Bold" Margin="12,0,0,10"/>
                    <Button x:Name="DashboardButton" Style="{StaticResource NavButton}" Background="#263B59"
                            Foreground="White" Click="Dashboard_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▦" Width="28" FontSize="17"/><TextBlock Text="Visão geral"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="Navigation_Click" Tag="Produtos">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▣" Width="28" FontSize="16"/><TextBlock Text="Produtos e serviços"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="Navigation_Click" Tag="Categorias">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▤" Width="28" FontSize="16"/><TextBlock Text="Categorias"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="Navigation_Click" Tag="Clientes">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="♙" Width="28" FontSize="18"/><TextBlock Text="Clientes"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="Navigation_Click" Tag="Pedidos">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▧" Width="28" FontSize="16"/><TextBlock Text="Pedidos"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="Navigation_Click" Tag="Pagamentos">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▱" Width="28" FontSize="17"/><TextBlock Text="Pagamentos"/></StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1" Background="#304158" Margin="0,0,0,16"/>
                    <Button Style="{StaticResource NavButton}" Click="Navigation_Click" Tag="Configurações">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Width="28" FontSize="16"/><TextBlock Text="Configurações"/></StackPanel>
                    </Button>
                    <Border Background="#243650" CornerRadius="10" Padding="12" Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="17" Background="#DCE7FF">
                                <TextBlock Text="AD" Foreground="#315DBB" FontWeight="Bold" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Administrador" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="Acesso completo" Foreground="#91A1B8" FontSize="10" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="#E9EDF3" BorderThickness="0,0,0,1">
                <Grid Margin="34,0,36,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="BreadcrumbText" Text="PÁGINAS  /  VISÃO GERAL" Foreground="#9AA4B2" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PageTitleText" Text="Visão geral" Foreground="#1F2937" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F5F7FB" CornerRadius="8" Padding="12,9" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⌕" FontSize="17" Foreground="#8B96A7" Margin="0,0,8,0"/>
                                <TextBox Width="175" BorderThickness="0" Background="Transparent" Foreground="#8993A4"
                                         Text="" ToolTip="Busca em desenvolvimento" IsEnabled="False" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Width="36" Height="36" CornerRadius="18" Background="#F0F4FC">
                            <TextBlock Text="♧" Foreground="#4776E6" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl x:Name="Abas" Grid.Row="1" SelectionChanged="Abas_SelectionChanged" Background="#F4F6FA" BorderThickness="0" SelectedIndex="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter Content="{TemplateBinding SelectedContent}"/>
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem Header="Visão geral">            <ScrollViewer  VerticalScrollBarVisibility="Auto">
                <Grid x:Name="DashboardContent" Margin="34,28,36,34">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,22">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Bom dia! 👋" FontSize="25" FontWeight="Bold" Foreground="#1F2937"/>
                            <TextBlock Text="Aqui está o resumo da sua loja hoje." Foreground="#8993A4" FontSize="13" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="+  Novo pedido" Click="NewOrder_Click" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- KPI cards -->
                    <UniformGrid  Columns="4" Margin="0,0,0,22">
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <DockPanel><TextBlock Text="VENDAS PAGAS" Style="{StaticResource SmallLabel}"/>
                                    <Border Background="#EAF1FF" CornerRadius="7" Padding="8,5" DockPanel.Dock="Right"><TextBlock Text="↗" Foreground="#4776E6"/></Border></DockPanel>
                                <TextBlock x:Name="TotalVendas" Text="R$ 0,00" FontSize="23" FontWeight="Bold" Foreground="#1F2937" Margin="0,15,0,5"/>
                                <TextBlock Text="Atualizado pelo SQL Server" FontSize="10" Foreground="#8993A4"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="4,0,8,0">
                            <StackPanel>
                                <DockPanel><TextBlock Text="PEDIDOS" Style="{StaticResource SmallLabel}"/>
                                    <Border Background="#E8F8F2" CornerRadius="7" Padding="8,5" DockPanel.Dock="Right"><TextBlock Text="▧" Foreground="#20A477"/></Border></DockPanel>
                                <TextBlock x:Name="TotalPedidos" Text="0" FontSize="23" FontWeight="Bold" Foreground="#1F2937" Margin="0,15,0,5"/>
                                <TextBlock Text="Atualizado pelo SQL Server" FontSize="10" Foreground="#8993A4"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="8,0,4,0">
                            <StackPanel>
                                <DockPanel><TextBlock Text="CLIENTES" Style="{StaticResource SmallLabel}"/>
                                    <Border Background="#FFF4E8" CornerRadius="7" Padding="8,5" DockPanel.Dock="Right"><TextBlock Text="♙" Foreground="#E69A42"/></Border></DockPanel>
                                <TextBlock x:Name="TotalClientes" Text="0" FontSize="23" FontWeight="Bold" Foreground="#1F2937" Margin="0,15,0,5"/>
                                <TextBlock Text="Atualizado pelo SQL Server" FontSize="10" Foreground="#8993A4"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="12,0,0,0">
                            <StackPanel>
                                <DockPanel><TextBlock Text="ITENS CADASTRADOS" Style="{StaticResource SmallLabel}"/>
                                    <Border Background="#F2ECFF" CornerRadius="7" Padding="8,5" DockPanel.Dock="Right"><TextBlock Text="◎" Foreground="#8661D5"/></Border></DockPanel>
                                <TextBlock x:Name="TotalItens" Text="0" FontSize="23" FontWeight="Bold" Foreground="#1F2937" Margin="0,15,0,5"/>
                                <TextBlock Text="Atualizado pelo SQL Server" FontSize="10" Foreground="#8993A4"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Chart and side panel -->
                    <Grid Grid.Row="2" Margin="0,0,0,22">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                                                 <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                             <StackPanel>
                                 <TextBlock Text="Banco de dados • Code First" FontSize="15" FontWeight="Bold" Foreground="#1F2937"/>
                                 <TextBlock Text="Entity Framework Core + SQL Server" Foreground="#8993A4" Margin="0,8,0,16"/>
                                 <TextBlock Text="Cadastre clientes e produtos; crie pedidos e registre pagamentos simulados. Os indicadores são atualizados a partir dos registros persistidos." TextWrapping="Wrap" Foreground="#596579" Margin="0,0,0,16"/>
                                 <WrapPanel>
                                     <Button Style="{StaticResource PrimaryButton}" Content="Atualizar indicadores" Click="Atualizar_Click" Margin="0,0,8,8"/>
                                     <Button Content="Consulta SQL direta" Click="Sql_Click" Padding="15,9" Margin="0,0,0,8"/>
                                 </WrapPanel>
                             </StackPanel>
                         </Border>
                         <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
                             <StackPanel>
                                 <TextBlock Text="Resumo de pedidos" FontSize="15" FontWeight="Bold" Foreground="#1F2937"/>
                                 <TextBlock Text="Situação atual no banco" FontSize="11" Foreground="#8993A4" Margin="0,4,0,20"/>
                                 <TextBlock Text="Pagos" Foreground="#596579" FontSize="12"/>
                                 <TextBlock x:Name="PedidosPagos" Text="0" FontSize="24" FontWeight="Bold" Foreground="#20A477" Margin="0,2,0,12"/>
                                 <TextBlock Text="Em aberto" Foreground="#596579" FontSize="12"/>
                                 <TextBlock x:Name="PedidosAbertos" Text="0" FontSize="24" FontWeight="Bold" Foreground="#E69A42" Margin="0,2,0,12"/>
                                 <TextBlock Text="Cancelados" Foreground="#596579" FontSize="12"/>
                                 <TextBlock x:Name="PedidosCancelados" Text="0" FontSize="24" FontWeight="Bold" Foreground="#D45E5E" Margin="0,2,0,12"/>
                             </StackPanel>
                         </Border>
</Grid>

                    <!-- Recent orders -->
                    <Border Grid.Row="3" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,17">
                                <StackPanel><TextBlock Text="Pedidos recentes" FontSize="15" FontWeight="Bold" Foreground="#1F2937"/>
                                    <TextBlock Text="Acompanhe as últimas movimentações da loja" FontSize="11" Foreground="#8993A4" Margin="0,4,0,0"/></StackPanel>
                                <Button Grid.Column="1" Content="Ver todos →" Background="Transparent" BorderThickness="0"
                                        Foreground="#4776E6" FontWeight="SemiBold" Cursor="Hand" HorizontalAlignment="Right"
                                        Click="ViewOrders_Click"/>
                            </Grid>
                                                         <DataGrid x:Name="PedidosRecentesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,9,0,0" BorderThickness="0" RowHeight="32" HeadersVisibility="Column" MinHeight="110">
                                 <DataGrid.Columns>
                                     <DataGridTextColumn Header="PEDIDO" Binding="{Binding Id}" Width="*"/>
                                     <DataGridTextColumn Header="CLIENTE" Binding="{Binding Cliente}" Width="2*"/>
                                     <DataGridTextColumn Header="DATA" Binding="{Binding Data, StringFormat=dd/MM/yyyy}" Width="*"/>
                                     <DataGridTextColumn Header="VALOR" Binding="{Binding Total, StringFormat={}{0:C}}" Width="*"/>
                                     <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="*"/>
                                 </DataGrid.Columns>
                             </DataGrid>
</StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer></TabItem>
<TabItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Header="Clientes">
                <Grid Margin="28,24,28,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Cadastro de clientes (PF / PJ)" FontSize="20" FontWeight="Bold" Margin="4,0,0,10"/>
                        <WrapPanel><TextBox Style="{StaticResource FormInput}" x:Name="ClienteNome" Width="200" ToolTip="Nome"/><TextBox Style="{StaticResource FormInput}" x:Name="ClienteEmail" Width="200" ToolTip="E-mail"/>
                            <ComboBox Style="{StaticResource FormCombo}" x:Name="ClienteTipo" Width="140" SelectedIndex="0"><ComboBoxItem Content="Pessoa fisica"/><ComboBoxItem Content="Pessoa juridica"/></ComboBox>
                            <TextBox Style="{StaticResource FormInput}" x:Name="ClienteDocumento" Width="175" ToolTip="CPF/CNPJ (somente demonstracao)"/></WrapPanel>
                        <WrapPanel><Button Content="Salvar" Click="ClienteSalvar_Click"/><Button Content="Novo / limpar" Click="ClienteLimpar_Click"/><Button Content="Excluir selecionado" Click="ClienteExcluir_Click"/><Button Content="Recarregar" Click="Atualizar_Click"/></WrapPanel>
                        <TextBlock Foreground="#657082" Margin="4,5" Text="Selecione uma linha para editar. Para excluir, o cliente nao pode possuir pedidos."/>
                    </StackPanel>
                    <DataGrid Style="{StaticResource FormDataGrid}" Grid.Row="1" x:Name="ClientesGrid" SelectionChanged="ClientesGrid_SelectionChanged"/>
                </Grid>
            </TabItem>
            
<TabItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Header="Produtos e serviços">
                <Grid Margin="28,24,28,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Produtos e serviços" FontSize="20" FontWeight="Bold" Margin="4,0,0,10"/>
                        <WrapPanel><TextBox Style="{StaticResource FormInput}" x:Name="ItemNome" Width="225" ToolTip="Nome"/><TextBox Style="{StaticResource FormInput}" x:Name="ItemPreco" Width="130" ToolTip="Preco (ex.: 19,90)"/>
                            <ComboBox Style="{StaticResource FormCombo}" x:Name="ItemTipo" Width="125" SelectedIndex="0"><ComboBoxItem Content="Produto"/><ComboBoxItem Content="Servico"/></ComboBox>
                            <TextBox Style="{StaticResource FormInput}" x:Name="ItemQuantidade" Width="140" ToolTip="Estoque ou duracao em horas"/></WrapPanel>
                        <WrapPanel><Button Content="Salvar" Click="ItemSalvar_Click"/><Button Content="Novo / limpar" Click="ItemLimpar_Click"/><Button Content="Excluir selecionado" Click="ItemExcluir_Click"/><Button Content="Recarregar" Click="Atualizar_Click"/></WrapPanel>
                        <TextBlock Margin="4,5" Foreground="#657082" Text="Quantidade = estoque para produtos ou duracao em horas para servicos. Selecione uma linha para editar."/>
                    </StackPanel>
                    <DataGrid Style="{StaticResource FormDataGrid}" Grid.Row="1" x:Name="ItensGrid" SelectionChanged="ItensGrid_SelectionChanged"/>
                </Grid>
            </TabItem>
            
<TabItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Header="Categorias">
                <Grid Margin="28,24,28,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Categorias e associacoes N:N" FontSize="20" FontWeight="Bold" Margin="4,0,0,10"/>
                        <WrapPanel><TextBox Style="{StaticResource FormInput}" x:Name="CategoriaNome" Width="240" ToolTip="Nome da categoria"/><Button Content="Salvar categoria" Click="CategoriaSalvar_Click"/><Button Content="Nova / limpar" Click="CategoriaLimpar_Click"/><Button Content="Excluir" Click="CategoriaExcluir_Click"/></WrapPanel>
                        <WrapPanel Margin="0,12,0,0"><TextBlock Text="Item:"/><ComboBox Style="{StaticResource FormCombo}" x:Name="CategoriaItemCombo" Width="220" DisplayMemberPath="Nome" SelectedValuePath="Id"/>
                            <TextBlock Text="Categoria:"/><ComboBox Style="{StaticResource FormCombo}" x:Name="CategoriaCombo" Width="220" DisplayMemberPath="Nome" SelectedValuePath="Id"/><Button Content="Associar item à categoria" Click="Associar_Click"/></WrapPanel>
                    </StackPanel>
                    <DataGrid Style="{StaticResource FormDataGrid}" Grid.Row="1" x:Name="CategoriasGrid" SelectionChanged="CategoriasGrid_SelectionChanged"/>
                </Grid>
            </TabItem>
            
<TabItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Header="Pedidos">
                <Grid Margin="28,24,28,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Novo pedido" FontSize="20" FontWeight="Bold" Margin="4,0,0,10"/>
                        <WrapPanel><TextBlock Text="Cliente:"/><ComboBox Style="{StaticResource FormCombo}" x:Name="PedidoClienteCombo" Width="225" DisplayMemberPath="Nome" SelectedValuePath="Id"/>
                            <TextBlock Text="Item:"/><ComboBox Style="{StaticResource FormCombo}" x:Name="PedidoItemCombo" Width="225" DisplayMemberPath="Nome" SelectedValuePath="Id"/>
                            <TextBlock Text="Quantidade:"/><TextBox Style="{StaticResource FormInput}" x:Name="PedidoQuantidade" Text="1" Width="65"/><Button Content="Criar pedido" Click="PedidoCriar_Click"/></WrapPanel>
                        <TextBlock Margin="4,8" Foreground="#657082" Text="O pedido salva o preco do item no momento da compra e reduz o estoque quando for produto."/>
                    </StackPanel>
                    <DataGrid Style="{StaticResource FormDataGrid}" Grid.Row="1" x:Name="PedidosGrid"/>
                </Grid>
            </TabItem>
            
<TabItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Header="Pagamentos">
                <Grid Margin="28,24,28,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Pagamento simulado (polimorfismo)" FontSize="20" FontWeight="Bold" Margin="4,0,0,10"/>
                        <WrapPanel><TextBlock Text="Pedido aberto:"/><ComboBox Style="{StaticResource FormCombo}" x:Name="PagamentoPedidoCombo" Width="245" DisplayMemberPath="Descricao" SelectedValuePath="Id"/>
                            <TextBlock Text="Forma:"/><ComboBox Style="{StaticResource FormCombo}" x:Name="PagamentoForma" Width="130" SelectedIndex="0"><ComboBoxItem Content="Pix"/><ComboBoxItem Content="Cartao"/><ComboBoxItem Content="Boleto"/></ComboBox>
                            <Button Content="Processar pagamento" Click="Pagar_Click"/></WrapPanel>
                    </StackPanel>
                    <DataGrid Style="{StaticResource FormDataGrid}" Grid.Row="1" x:Name="PagamentosGrid"/>
                </Grid>
            </TabItem>
        
            </TabControl>
        </Grid>
    </Grid>
</Window>
